BP_JVM_VERSION=25
BP_GRADLE_BUILD_ARGUMENTS=--no-daemon --console=plain clean build
BP_GRADLE_BUILT_ARTIFACT=build/libs/catalog-service.jar
BP_SPRING_CLOUD_BINDINGS_DISABLED=true
BP_NATIVE_IMAGE=false
BP_SPRING_AOT_ENABLED=false
BP_JVM_AOTCACHE_ENABLED=false
JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseG1GC -XX:ReservedCodeCacheSize=64m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=10m -Xss512k
BPE_APPEND_JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseG1GC -XX:ReservedCodeCacheSize=64m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=10m -Xss512k
BPE_OVERRIDE_BPL_JVM_THREAD_COUNT=50
